# Example environment variables for Family-MCP

# FamilySearch access token (required)
# Get from: https://www.familysearch.org/developers/
FAMILYSEARCH_TOKEN=your-access-token-here

# Optional: Password for encrypted token storage
# If not set, uses a default password
FAMILY_MCP_PASSWORD=your-secure-password-here

# Optional: Custom FamilySearch API base URL
# Defaults to: https://api.familysearch.org/platform
# FAMILYSEARCH_BASE_URL=https://api.familysearch.org/platform
